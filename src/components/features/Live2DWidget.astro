---
import { url } from "@/utils/url-utils";

interface Props {
	config: {
		enable: boolean;
		model:
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }[];
		position?: "bottom-left" | "bottom-right";
		size?: number | { width: number; height: number };
		responsive?: {
			hideOnMobile?: boolean;
			mobileBreakpoint?: number;
		};
	};
}

const { config } = Astro.props;
const models = Array.isArray(config.model) ? config.model : [config.model];
const resolvePath = (p: string) => (/^https?:\/\//.test(p) ? p : url(p));
const modelPath = resolvePath(models[0].path);

// 桌宠画布尺寸（放大：旧版 200x200，这里给到 420x520）
const boxSize =
	typeof config.size === "object" && config.size
		? { width: 420, height: 520 }
		: { width: 420, height: 520 };

const position = config.position || "bottom-left";
const responsive = config.responsive || {};
---

<div
	id="l2d-widget-container"
	data-path={modelPath}
	data-position={position}
	data-width={boxSize.width.toString()}
	data-height={boxSize.height.toString()}
	data-hide-mobile={(responsive.hideOnMobile === true).toString()}
	data-breakpoint={(responsive.mobileBreakpoint || 768).toString()}
>
	<button id="l2d-close" title="关闭桌宠" aria-label="关闭桌宠">×</button>
	<div id="l2d-stage"></div>
</div>
<button id="l2d-restore" title="显示桌宠" aria-label="显示桌宠">🐱</button>

<style>
	#l2d-widget-container {
		position: fixed;
		left: 0;
		bottom: 0;
		width: 420px;
		height: 520px;
		z-index: 9999;
		/* 拖动时可按住移动 */
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
		touch-action: none;
	}
	#l2d-widget-container:active {
		cursor: grabbing;
	}
	#l2d-widget-container.bottom-right {
		left: auto;
		right: 0;
	}
	#l2d-widget-container canvas {
		display: block;
	}
	#l2d-close {
		position: absolute;
		top: 6px;
		right: 10px;
		z-index: 2;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		border: none;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		font-size: 18px;
		line-height: 1;
		cursor: pointer;
	}
	#l2d-restore {
		position: fixed;
		left: 12px;
		bottom: 12px;
		z-index: 9999;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: none;
		background: rgba(96, 165, 250, 0.9);
		font-size: 22px;
		cursor: pointer;
		display: none;
	}
</style>

<script>
	function loadScript(src: string): Promise<void> {
		return new Promise((resolve, reject) => {
			const s = document.createElement("script");
			s.src = src;
			s.onload = () => resolve();
			s.onerror = () => reject(new Error("failed to load " + src));
			document.head.appendChild(s);
		});
	}

	function initWidget() {
		const container = document.getElementById("l2d-widget-container");
		if (!container) return;

		const path = container.dataset.path || "";
		const w = parseInt(container.dataset.width || "420");
		const h = parseInt(container.dataset.height || "520");
		const hideMobile = container.dataset.hideMobile === "true";
		const bp = parseInt(container.dataset.breakpoint || "768");

		if (hideMobile && window.innerWidth <= bp) {
			container.style.display = "none";
			return;
		}

		if (!path) {
			console.warn("[live2d] no model path");
			return;
		}

		// 关闭 / 恢复按钮（记住关闭状态）
		const restoreBtn = document.getElementById("l2d-restore");
		const closeBtn = document.getElementById("l2d-close");
		if (localStorage.getItem("l2d-closed") === "1") {
			container.style.display = "none";
			if (restoreBtn) restoreBtn.style.display = "block";
			return;
		}
		if (closeBtn) {
			closeBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				container.style.display = "none";
				localStorage.setItem("l2d-closed", "1");
				if (restoreBtn) restoreBtn.style.display = "block";
			});
		}
		if (restoreBtn) {
			restoreBtn.addEventListener("click", () => {
				container.style.display = "";
				localStorage.removeItem("l2d-closed");
				restoreBtn.style.display = "none";
			});
		}

		(async () => {
			try {
				// 1) 官方 Cubism Core（运行时从官方地址加载，不打包、不重传）
				await loadScript(
					"https://cubism.live2d.com/sdk-web/cubismcore/live2dcubismcore.min.js"
				);
				// 2) pixi.js v6（pixi-live2d-display 0.4 依赖 v6）
				await loadScript(
					"https://fastly.jsdelivr.net/npm/pixi.js@6.5.10/dist/browser/pixi.min.js"
				);
				// 3) pixi-live2d-display（cubism4 构建，支持 moc3/Cubism5）
				await loadScript(
					"https://fastly.jsdelivr.net/npm/pixi-live2d-display@0.4.0/dist/cubism4.min.js"
				);
			} catch (e) {
				console.error("[live2d] runtime load failed:", e);
				container.style.display = "none";
				return;
			}

			// @ts-ignore
			const PIXI = (window as any).PIXI;
			// pixi-live2d-display 把 Live2DModel 挂在 PIXI.live2d 下
			const Live2DModel = PIXI && PIXI.live2d && PIXI.live2d.Live2DModel;
			if (!PIXI || !Live2DModel) {
				console.error("[live2d] pixi/live2d lib missing", { PIXI: !!PIXI, live2d: !!(PIXI && PIXI.live2d) });
				container.style.display = "none";
				return;
			}

			const stage = document.getElementById("l2d-stage") as HTMLElement;

			const app = new PIXI.Application({
				width: w,
				height: h,
				backgroundColor: 0x000000,
				backgroundAlpha: 0,
				resolution: window.devicePixelRatio || 1,
				autoDensity: true,
			});
			stage.appendChild(app.view as HTMLCanvasElement);

			let model: any;
			try {
				model = await Live2DModel.from(path, { autoInteract: false });
			} catch (e) {
				console.error("[live2d] model load failed:", e);
				container.style.display = "none";
				return;
			}

			app.stage.addChild(model);

			// 让模型适配画布并居中靠下
			model.anchor.set(0.5, 0.5);
			const scale = Math.min(
				app.screen.width / model.width,
				app.screen.height / model.height
			) * 0.96;
			model.scale.set(scale);
			model.position.set(app.screen.width / 2, app.screen.height / 2);

			// 鼠标拖动整个桌宠
			let dragging = false;
			let moved = false;
			let offX = 0;
			let offY = 0;

			container.addEventListener("pointerdown", (e) => {
				dragging = true;
				moved = false;
				const rect = container.getBoundingClientRect();
				offX = e.clientX - rect.left;
				offY = e.clientY - rect.top;
				container.style.transition = "none";
			});
			window.addEventListener("pointermove", (e) => {
				if (!dragging) return;
				moved = true;
				container.style.left = e.clientX - offX + "px";
				container.style.top = e.clientY - offY + "px";
				container.style.right = "auto";
				container.style.bottom = "auto";
			});
			window.addEventListener("pointerup", () => {
				dragging = false;
			});

			// 鼠标跟踪：眼睛 + 头/身体跟着鼠标（在模型 update 之后写参数，避免被覆盖）
			const look = { x: 0, y: 0 };
			window.addEventListener("pointermove", (e) => {
				look.x = (e.clientX / window.innerWidth) * 2 - 1;
				look.y = (e.clientY / window.innerHeight) * 2 - 1;
			});
			const core = model.internalModel.coreModel;
			// 打印一下实际参数 ID，方便核对
			try {
				const ids = core.getParameterIds ? core.getParameterIds() : [];
				console.log("[live2d] params sample:", ids.filter((s: string) => /Eye|Angle|Body|Waist|Neck/i.test(s)).join(", "));
			} catch {}
			model.internalModel.on("afterUpdate", () => {
				try {
					core.setParameterValueById("Param229", 1);
					core.setParameterValueById("ParamEyeBallX", look.x);
					core.setParameterValueById("ParamEyeBallY", -look.y);
					core.setParameterValueById("ParamAngleX3", look.x * 30);
					core.setParameterValueById("ParamAngleX4", -look.y * 20);
				} catch {}
			});
		})();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWidget);
	} else {
		initWidget();
	}
</script>
